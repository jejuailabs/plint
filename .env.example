# 환경변수 역할표: docs/10-environment-key-reference.md

# Public application — 배포 주소·OAuth 콜백 기준
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — 로그인·프로젝트·분석결과 저장. publishable은 브라우저 공개 가능, secret은 서버 전용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Supabase 관리/CLI 작업 전용. 앱 클라이언트나 서버 라우트에서 사용하지 않음
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# 주소정보누리집 — 표준 주소·지번·건물번호·좌표·상세 동/층/호
JUSO_API_KEY=
JUSO_ENGLISH_API_KEY=
JUSO_DETAIL_ADDRESS_API_KEY=

# 국토교통부·공공데이터포털 — 건축물대장·건축인허가·상가업소·실거래 등 데이터셋 공통 키
DATA_GO_KR_API_KEY=

# 지도·공간 — 필지, 연속지적도, 용도지역, 항공영상, WMS/WFS 지도 레이어
# NED 데이터(개별공시지가·토지이용계획·토지특성)도 VWorld로 이관됨 (2024-01~)
VWORLD_API_KEY=
VWORLD_DOMAIN=
# 한국부동산원 — 부동산 가격·거래·시장지표
REB_API_KEY=
# 기상청 — 강수·폭염·일조·기후 리스크
KMA_API_KEY=
# SGIS — 인구·연령·가구·사업체·종사자·배후수요
SGIS_CONSUMER_KEY=
SGIS_CONSUMER_SECRET=

# Cesium Ion — 3D 지형·OSM 3D 건물·글로벌 이미저리. 브라우저에서 사용하므로 NEXT_PUBLIC_ 접두어
NEXT_PUBLIC_CESIUM_ION_TOKEN=

# 외부 3D 모델링 작업자 — SketchUp 자동 모델링/GLB 생성 (연결 전까지 목업 유지)
SKETCHUP_MCP_ENDPOINT=
SKETCHUP_MCP_API_KEY=

# RunPod Blender GPU 워커 — 키는 서버 전용, Endpoint ID는 Serverless Endpoint 생성 뒤 입력
# 기존 RUNPOD 이름과 표준 RUNPOD_API_KEY 이름을 모두 지원
RUNPOD=
RUNPOD_ENDPOINT_ID=

# AI 보고서 초안·설명 생성 — 실제 분석 근거와 출처를 대체하지 않음
OPENAI_API_KEY=
# CLAUDE_API_KEY를 현재 호환 별칭으로 사용. 신규 설정은 ANTHROPIC_API_KEY 권장
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# 결제 — 유료 보고서 다운로드·결제 승인·웹훅 검증
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=
PORTONE_WEBHOOK_SECRET=

# Google OAuth — Supabase Google 공급자 설정 또는 향후 직접 OAuth 연동용
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 개발 모드 — true면 실제 외부 API 대신 결정론적 목업 응답 (운영 환경에서는 반드시 false)
USE_MOCK_EXTERNAL_API=false
